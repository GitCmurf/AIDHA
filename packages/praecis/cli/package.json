{
  "name": "@aidha/praecis-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "aidha": "./dist/cli.js"
  },
  "author": "Colin Farmer (GitCmurf) (https://github.com/GitCmurf)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GitCmurf/AIDHA.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:ci": "vitest run --silent --reporter=dot",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aidha/config": "workspace:*",
    "@aidha/graph-backend": "workspace:*",
    "@aidha/ingestion-youtube": "workspace:*",
    "@aidha/praecis-core": "workspace:*",
    "@aidha/praecis-source-email": "workspace:*",
    "@aidha/praecis-source-readwise": "workspace:*",
    "@aidha/praecis-source-feeds": "workspace:*",
    "@aidha/praecis-source-pdf": "workspace:*",
    "@aidha/praecis-source-voice": "workspace:*",
    "@aidha/praecis-source-meetings": "workspace:*",
    "@aidha/praecis-source-web": "workspace:*",
    "@aidha/praecis-source-linkedin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
