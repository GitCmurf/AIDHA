{
  "name": "aidha",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.8"
    }
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "gen:types": "pnpm --filter @aidha/config gen:types",
    "security:public-paths": "node scripts/check-public-safety.mjs",
    "security:public-paths:test": "node scripts/test-public-safety.mjs",
    "test": "node scripts/check-test-scripts.mjs && pnpm security:public-paths && pnpm security:public-paths:test && pnpm test:semantic-quality && pnpm test:decision-quality && pnpm -r --workspace-concurrency=1 test:ci",
    "test:semantic-quality": "node scripts/semantic-quality/run.test.mjs && node scripts/semantic-quality/native-client.test.mjs && node scripts/semantic-quality/agy-client.test.mjs",
    "test:full": "pnpm -r --workspace-concurrency=1 --if-present test:full",
    "build": "pnpm -r build",
    "build:deps": "pnpm --filter @aidha/config --filter @aidha/graph-backend --filter @aidha/taxonomy --filter @aidha/praecis-core --filter \"@aidha/praecis-decode-*\" --filter \"@aidha/praecis-acquire-*\" build",
    "docs:serve": "./scripts/python -m mkdocs serve",
    "docs:catalog": "./scripts/python docs/_scripts/gen_catalog.py",
    "docs:linkcheck": "./scripts/python docs/_scripts/linkcheck.py",
    "docs:build": "./scripts/python docs/_scripts/gen_catalog.py && ./scripts/python docs/_scripts/validate_docs.py && ./scripts/python -m mkdocs build --strict",
    "test:decision-quality": "node scripts/decision-quality/category.test.mjs && node scripts/decision-quality/grounding.test.mjs && node scripts/decision-quality/quality.test.mjs && node scripts/decision-quality/run.test.mjs",
    "decision:baseline": "node scripts/decision-quality/run.mjs --baseline",
    "decision:requests": "node scripts/decision-quality/run.mjs --requests"
  }
}
